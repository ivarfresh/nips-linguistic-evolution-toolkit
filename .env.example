# Copy to .env and fill in the keys you need. src/utils.py loads this file
# at import time via python-dotenv.

# Main provider (OpenRouter routes to most models used in the experiments)
OPENROUTER_API_KEY=

# Optional direct-provider keys (used when LLM_PROVIDER selects them,
# or by provider-specific runs)
TOGETHER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional overrides (see src/utils.py)
# Provider route, reasoning level and temperature are pinned PER EXPERIMENT
# SET in config/*.yaml (`llm_settings:` block, see src/llm_settings.py); the
# batch runners refuse to start without it. The variables below only
# OVERRIDE that block and every override is recorded in run_metadata:
# LLM_PROVIDER=direct        # direct | openrouter
# LLM_REASONING=off          # off | minimal | low | medium | high
# LLM_TEMPERATURE=default    # default | <float>
# Legacy knobs, ignored once an llm_settings block is active (still used by
# ad-hoc scripts that call run_simulation without one):
# OPENROUTER_MAX_TOKENS=
# OPENROUTER_REASONING_EFFORT=
# OPENAI_REASONING_EFFORT=
# GEMINI_THINKING_LEVEL=
# Direct-Anthropic responses default to max_tokens=1024, which truncates
# verbose game analyses before the JSON decision. Raise it:
ANTHROPIC_MAX_TOKENS=4096
