# Copy this file to `.env` and fill in your actual keys.
# The `.env` file is gitignored.

# Provider selection:
#   auto       direct OpenAI/Anthropic for matching model slugs when keys exist,
#              otherwise OpenRouter fallback
#   direct     require direct OpenAI/Anthropic; no OpenRouter fallback
#   openrouter force OpenRouter
LLM_PROVIDER=auto

# Direct provider API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Anthropic output cap for direct Anthropic calls
ANTHROPIC_MAX_TOKENS=1024

# OpenRouter API key (needed for Google/Gemini models and as fallback)
OPENROUTER_API_KEY=

# Together AI API key (kept for compatibility with older scripts that use Together)
TOGETHER_API_KEY=

# Optional direct model override example:
# LLM_DIRECT_MODEL_ANTHROPIC_CLAUDE_SONNET_4_5=claude-sonnet-4-5-20250929
